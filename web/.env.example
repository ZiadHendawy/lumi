# Copy to .env.local and fill in your own values (never commit it):
#   cp .env.example .env.local
# Leave a line empty rather than writing a placeholder: empty means "not set".
# On Vercel, set the same names under Project > Settings > Environment Variables.

# Required: the same LiveKit project as the agent. /api/token signs room tokens with them.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the /stats page. Without STATS_PASSWORD it stays locked for everyone.
STATS_PASSWORD=
# A read-only Postgres role that can only SELECT provider_usage and turn_metrics.
STATS_DATABASE_URL=
# Shows this month's Tavily searches (the same key as the agent's).
TAVILY_API_KEY=
# Shows the Deepgram credit balance: a key with usage:read and billing:read scopes.
DEEPGRAM_USAGE_KEY=
