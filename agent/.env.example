# Copy to .env.local and fill in your own values (never commit it):
#   cp .env.example .env.local
# Leave a line empty rather than writing a placeholder: empty means "not set".
# A deployed agent reads the same names from LiveKit Cloud secrets instead.

# LiveKit Cloud: your project's URL (wss://...) and an API key and secret.
# `lk cloud auth` links a project; the dashboard's Settings > API keys creates a key.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only for deploying: the ID (CA_...) that `lk agent create` prints. Deploy with
#   uv run --env-file .env.local -- sh -c 'lk agent deploy --id "$LIVEKIT_AGENT_ID"'
LIVEKIT_AGENT_ID=

# Speech to text and the voice (console.deepgram.com, free credit)
DEEPGRAM_API_KEY=

# The main LLMs (console.groq.com/keys, free tier)
GROQ_API_KEY=

# The fallback LLM (aistudio.google.com/apikey, free tier)
GEMINI_API_KEY=

# Web search (app.tavily.com, free tier, no card)
TAVILY_API_KEY=

# Postgres for tasks and facts: a Neon project's connection string (console.neon.tech).
# The agent creates its tables on first connect.
DATABASE_URL=

# Optional, used only by pytest: a separate Neon branch (e.g. "test"), so tests never
# touch your real board. Leave it empty and the database tests are skipped.
TEST_DATABASE_URL=

# Optional overrides. Defaults are shown; uncomment a line only to change it.
# Keep them commented out otherwise: an empty CALENDAR_DAYS= fails at startup.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
# TTS_VOICE=aura-2-andromeda-en
# CALENDAR_DAYS=14
